# Runtime mode
APP_ENV=dev
APP_LOG_LEVEL=INFO
MOCK_MODE=true

# API
BACKEND_HOST=0.0.0.0
BACKEND_PORT=18010
FRONTEND_HOST=0.0.0.0
FRONTEND_PORT=13000
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:18010

# Database
DATABASE_URL=sqlite:///./automation_factory_lite.db
POSTGRES_DB=aflite
POSTGRES_USER=aflite
POSTGRES_PASSWORD=aflite

# LLM
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ENABLE_LANGGRAPH=false

# Optional ITSM webhook for external ticket updates
ITSM_WEBHOOK_ENABLED=false
ITSM_WEBHOOK_URL=
ITSM_WEBHOOK_TOKEN=
ITSM_WEBHOOK_TIMEOUT_SECONDS=5

# ServiceNow MCP bridge (simulation / integration layer)
SERVICENOW_MCP_ENABLED=true
SERVICENOW_MCP_MODE=external_http_bridge
SERVICENOW_MCP_ENDPOINT=
SERVICENOW_MCP_SERVER_CMD="python3 services/servicenow_sim/mcp_server.py"
SERVICENOW_SIM_HOST=0.0.0.0
SERVICENOW_SIM_PORT=18095
SERVICENOW_EXTERNAL_ENABLED=true
SERVICENOW_EXTERNAL_BASE_URL=http://127.0.0.1:18095
SERVICENOW_EXTERNAL_VERIFY_TLS=false
SERVICENOW_EXTERNAL_TIMEOUT_SECONDS=5
AFL_BACKEND_BASE_URL=http://127.0.0.1:18010
AFL_FRONTEND_BASE_URL=http://127.0.0.1:13000

# AWX
AWX_MODE=mock
AWX_URL=
AWX_TOKEN=
AWX_VERIFY_TLS=false
AWX_ORGANIZATION=AutomationFactory
AWX_PROJECT=AutomationFactoryProject
AWX_INVENTORY=AutomationFactoryInventory
AWX_CREDENTIAL_ID=
AWX_PROJECT_SCM_TYPE=git
AWX_PROJECT_SCM_URL=
AWX_PROJECT_SCM_BRANCH=main
AWX_PROJECT_SCM_UPDATE_ON_LAUNCH=false
AWX_MACHINE_CREDENTIAL_NAME=

# Targets
TARGET_HOST_1=192.168.250.30
TARGET_HOST_1_NAME=ol9server1
TARGET_HOST_2=192.168.250.40
TARGET_HOST_2_NAME=rocky9server1
